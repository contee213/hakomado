{
  "name": "hakomado-feed",
  "private": true,
  "description": "Hakomado Feed (共有された視聴セットを集める Web アプリ。Cloudflare Workers + D1)",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.js",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply hakomado-feed --local",
    "db:migrate:remote": "wrangler d1 migrations apply hakomado-feed --remote",
    "db:migrate:staging": "wrangler d1 migrations apply hakomado-feed-staging --remote --env staging",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "wrangler": "^4.166.0"
  }
}
