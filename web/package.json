{
  "name": "hakomado-sets",
  "private": true,
  "description": "Hakomado セット集 (共有された視聴セットを集める Web アプリ。Cloudflare Workers + D1)",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.js",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply hakomado-sets --local",
    "db:migrate:remote": "wrangler d1 migrations apply hakomado-sets --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
