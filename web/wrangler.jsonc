// Hakomado Feed (画面の名前は Hakomado) (Cloudflare Workers + 静的アセット + D1)。使い方は README.md
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hakomado-feed",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  // 外への fetch を公開のアドレスだけにする (MCP の OAuth で、クライアントの情報 (CIMD) の URL を取りに行くのに要る)
  "compatibility_flags": ["global_fetch_strictly_public"],
  // 本番のドメイン (contee.net は同じアカウントの Cloudflare のゾーン。DNS レコードと証明書はデプロイのときに自動で作られる)
  "routes": [{ "pattern": "hakomado.contee.net", "custom_domain": true }],
  // 最初に出した hakomado-feed.contee213.workers.dev も残す。プレビュー用の URL は使わない
  "workers_dev": true,
  "preview_urls": false,
  // 拡張機能のスクリプト (share-code.js・layouts.js) を src/gen/ と public/js/ext/ に置く
  "build": {
    "command": "node tools/build.js",
    "watch_dir": ["src", "../extension"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // API・MCP・セットの画面 (OGP を入れる)・投稿の画面 (1 枚の画面 index.html を返す) だけ Worker を通す。ほかは静的アセットをそのまま返す
    // MCP の OAuth (/authorize・/oauth/*・/.well-known/oauth-*) も Worker を通す
    "run_worker_first": ["/api/*", "/s/*", "/post", "/post/", "/mcp", "/config.js", "/authorize", "/oauth/*", "/.well-known/oauth-*", "/auth/*", "/me", "/me/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hakomado-feed",
      // 本番の D1 (npx wrangler d1 create hakomado-feed で作ったもの)。ローカルの開発 (wrangler dev) は手元の D1 を使う
      "database_id": "78e4aab7-d89b-4686-9c21-5775d5ed1c8a",
      "migrations_dir": "migrations"
    }
  ],
  // MCP の OAuth (oauth.mjs) のクライアント・許可・トークン (トークンはハッシュで持つ)
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "6d1de197d0b7481cb06a1f59013ca8f1" }],
  "vars": {
    // 公開の URL (MCP の OAuth の resource = <これ>/mcp。claude.ai のコネクタにはこの URL を入れる)
    "PUBLIC_ORIGIN": "https://hakomado.contee.net",
    // /authorize を守る Cloudflare Access のチームのドメインと、そのアプリの AUD (README の「MCP」)。
    // 通してよい人のメールアドレスはシークレット OWNER_EMAIL
    "ACCESS_TEAM_DOMAIN": "orange-scene-fc8e.cloudflareaccess.com",
    // Access のアプリ「hakomado-feed /authorize (MCP OAuth)」(hakomado.contee.net/authorize だけを守る) の AUD
    "ACCESS_AUD": "6637edbe7875f794729d161e396a19b362340aabfaca0526f4d46f4ae2863cd7",
    // X でログイン (機能フラグ xLogin) の X のアプリのクライアント ID。シークレットは X_CLIENT_SECRET、
    // MCP の許可を X でログインで出す持ち主の X のユーザー ID は OWNER_X_ID (どちらも wrangler secret put)
    "X_CLIENT_ID": "SzFRT21wUHNaZUFPWGhpeGVHaFA6MTpjaQ",
    // Turnstile のサイトキー (空なら投稿フォームに確認を出さない)。シークレットは wrangler secret put TURNSTILE_SECRET
    "TURNSTILE_SITE_KEY": "",
    // 機能フラグ (true でオン。書いていないものはオフ。中身は src/features.mjs)
    "FEATURES": {
      "unlisted": true, // 公開範囲 (リンクを知っている人だけ) を選べる
      "tags": true, // タグ
      "search": true, // 検索
      "videoCheck": true, // 消えた動画の見直し (下の triggers の Cron で動く)
      "en": true, // 英語の画面
      "xLogin": true // X でログイン (X_CLIENT_ID・X_CLIENT_SECRET を設定するまでは出ない)
    }
  },
  // 消えた動画の見直し (1 時間ごとに、長く見直していないセットから動画 40 本分まで)
  "triggers": { "crons": ["23 * * * *"] },
  "observability": { "enabled": true },

  // ステージング (本番の手前で、Cloudflare の上で確かめる所)。npm run deploy:staging で
  // https://hakomado-feed-staging.contee213.workers.dev に出る。Cloudflare Access で自分だけが見られるようにする (README)。
  // wrangler の環境は vars・d1_databases・kv_namespaces を上から引き継がないので全部書く。routes・triggers は引き継ぐので、
  // 本番のドメインに付かないように routes を空にし、Cron は 1 日 1 回にする。
  // 本番とずれていないかは tests/web.test.js の「wrangler.jsonc」で確かめる
  "env": {
    "staging": {
      "name": "hakomado-feed-staging",
      // contee.net の下に置かない (Web Analytics に数えられて本番の数に混ざるので)
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hakomado-feed-staging",
          "database_id": "648fc116-701d-4f1b-a41f-d3fd17993448",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "b445fce72ef64f20af22e5fa9205569d" }],
      "vars": {
        "PUBLIC_ORIGIN": "https://hakomado-feed-staging.contee213.workers.dev",
        "ACCESS_TEAM_DOMAIN": "orange-scene-fc8e.cloudflareaccess.com",
        // ステージングは Worker 全体を Access で守っているので、その (workers.dev の) アプリの AUD
        "ACCESS_AUD": "344d0f334403230e824c03c42cf5cb3c172fba7cc3f341577de24358e3d9ae91",
        "X_CLIENT_ID": "SzFRT21wUHNaZUFPWGhpeGVHaFA6MTpjaQ",
        "TURNSTILE_SITE_KEY": "",
        // 本番と同じにしておく (新しい機能を先にここだけでオンにして試すのはいい)
        "FEATURES": {
          "unlisted": true,
          "tags": true,
          "search": true,
          "videoCheck": true,
          "en": true,
          "xLogin": true
        }
      },
      "triggers": { "crons": ["23 3 * * *"] }
    }
  }
}
